       "    if (length(batches) == 1L) \\{\n",
       "        sce <- batches{[}{[}1{]}{]}\n",
       "        if (is.null(batch)) \\{\n",
       "            stop(\"'batch' must be specified if '...' has only one object\")\n",
       "        \\}\n",
       "        by.batch <- split(seq\\_along(batch), batch)\n",
       "        batches <- by.batch\n",
       "        for (i in seq\\_along(by.batch)) \\{\n",
       "            batches{[}{[}i{]}{]} <- sce{[}, by.batch{[}{[}i{]}{]}, drop = FALSE{]}\n",
       "        \\}\n",
       "    \\}\n",
       "    else \\{\n",
       "        preserve.single <- FALSE\n",
       "    \\}\n",
